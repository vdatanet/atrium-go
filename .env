# Credentials for measuring this server. Copy to `.env` and fill in.
#
#   cp .env.example .env
#
# `.env` is git-ignored and must stay that way. Nothing in this repository reads
# these at runtime: Atrium itself takes its settings from flags and its own data
# directory. They are read by the differential harness and the probes, which live
# in the source repository and are pointed at this server over HTTP
# (docs/compatibility/conformance.md, L3).
#
# No CI job may contact or start a Jellyfin, so no CI job needs this file.

# --- The reference: a real Jellyfin of the pinned version -------------------
#
# Required only for a differential run against a server somebody already has.
# A run invoked with `--fixture` stands up its own single-use instance from the
# digest-pinned image and destroys it afterwards, and needs none of these
# (docs/decisions/0007-a-container-runtime-for-the-reference-instance.md).
#
# The instance this points at must be 10.11.11 — the version every measurement
# in this repository was taken against (docs/compatibility/reference-target.md).
#
# WARNING: a differential run WRITES. Pointing this at a server holding a real
# library means writing to data the run does not own; 009's probe runs left 28
# playlists behind on exactly such a server. Prefer `--fixture`.

JELLYFIN_URL=https://www.vdata.media:7920

# Either a username and password, or a token. A token avoids putting a password
# in a file; a username and password is what a first run has.
JELLYFIN_USERNAME=joan
JELLYFIN_PASSWORD=bg2121
JELLYFIN_TOKEN=

# --- The server under test: Atrium ------------------------------------------
#
# There is deliberately no ATRIUM_URL. The harness takes the address as a flag —
# `--atrium http://localhost:8096` — because it is a property of the run, not of
# the machine.
#
# The default identities a run compares from are the administrator and a
# restricted non-administrator: 12 of 23 reads of the surface answer differently
# to the second, so a run authenticated as one seat measures half the table
# (010 section 3.9).

ATRIUM_USERNAME=
ATRIUM_PASSWORD=
ATRIUM_TOKEN=
